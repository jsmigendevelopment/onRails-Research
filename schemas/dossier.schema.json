{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-dossier/1",
  "title": "Dossier card",
  "description": "dossier.json: what one dossier is, how it is tagged and where it stands. scripts/check.mjs enforces this file and the rules it can't express (see CONTRIBUTING.md).",
  "type": "object",
  "required": ["schema", "id", "title", "question", "summary", "created", "checked", "recheck", "status", "version", "tags", "supersedes", "superseded_by", "retraction", "history"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "research-dossier/1" },
    "id": { "$ref": "#/$defs/id", "description": "The creation date and a short slug. It is also the folder name. It never changes." },
    "title": { "type": "string", "minLength": 8, "maxLength": 120, "description": "May change. The id does not." },
    "question": { "type": "string", "minLength": 12, "maxLength": 240, "description": "The one question this dossier answers." },
    "summary": { "type": "string", "minLength": 40, "maxLength": 600, "description": "The answer, in two or three sentences." },
    "created": { "$ref": "#/$defs/date", "description": "The day the dossier was first written. Same as the date in the id." },
    "checked": { "$ref": "#/$defs/date", "description": "The day its facts were last checked in full: first publication, or the latest re-check." },
    "recheck": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day it goes stale. Null only when superseded or retracted." },
    "status": { "enum": ["current", "superseded", "retracted"], "description": "Stale is not written here. The index works it out from recheck." },
    "version": { "type": "integer", "description": "Starts at 1. Goes up by 1 with each correction or re-check." },
    "tags": {
      "type": "object",
      "required": ["domain", "topic", "kind", "stack"],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" }, "description": "From tags/domain.json. The first one is the primary domain." },
        "topic": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" }, "description": "From tags/topic.json." },
        "kind": { "$ref": "#/$defs/tag", "description": "Exactly one, from tags/kind.json." },
        "stack": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" }, "description": "From tags/stack.json. Empty when no tool or platform drives the answer." }
      }
    },
    "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "description": "The dossiers this one replaces." },
    "superseded_by": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$", "description": "The dossier that replaced this one." },
    "retraction": {
      "type": ["object", "null"],
      "required": ["date", "reason"],
      "additionalProperties": false,
      "properties": { "date": { "$ref": "#/$defs/date" }, "reason": { "type": "string", "minLength": 20 } }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "date", "change", "note"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "integer" },
          "date": { "$ref": "#/$defs/date" },
          "change": { "enum": ["published", "corrected", "rechecked", "edited", "superseded", "retracted"] },
          "note": { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      }
    },
    "credits": {
      "type": "array",
      "description": "Optional. Who to credit, as they want to be named. No e-mail addresses.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "github": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tag": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 }
  }
}
